# ============================================================================
# alpaca-gemini-trader — Environment Configuration Template
# Copy this file to `.env` and populate your credentials locally.
# NEVER commit `.env` or paste API keys into chat logs.
# ============================================================================

# --- Safety & Execution Mode Lock (MANDATORY: MUST BE "PAPER") ---
TRADING_MODE=PAPER
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Alpaca Paper Trading Credentials ---
APCA_API_KEY_ID=PK_YOUR_PAPER_API_KEY_ID_HERE
APCA_API_SECRET_KEY=YOUR_PAPER_API_SECRET_KEY_HERE

# --- Google GenAI SDK Credentials & Model ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Default: gemini-3.8-flash; ANALYST_MODE can be GEMINI (default) or RULES (deterministic offline/no-key/$0 mode)
GEMINI_MODEL=gemini-3.8-flash
ANALYST_MODE=GEMINI
ANALYST_CACHE_MINUTES=60

# --- Deterministic Risk Gateway Thresholds ---
# TRD-POL-001: Single-ticker total notional exposure cap (5% of total equity)
MAX_POSITION_PCT=0.05
# TRD-POL-004: Maximum dip-ladder add-on tranches (hard capped at 2) and 20d realized vol ceiling
MAX_DIP_TRANCHES=2
MAX_REALIZED_VOL_20D=0.60
# TRD-POL-005: Per-ticker order cooldown window in minutes
ORDER_COOLDOWN_MINUTES=15
# TRD-POL-006: Portfolio intraday drawdown circuit breaker (2% of daily starting equity)
MAX_DAILY_DRAWDOWN_PCT=0.02

# --- Strategy Parameters & Watchlists ---
MOMENTUM_WATCHLIST=AAPL,MSFT,NVDA,AMZN,META
WHEEL_WATCHLIST=F,PFE,T,SOFI,INTC
CREDIT_SPREAD_WATCHLIST=GOOGL
WEEKLY_CREDIT_TARGET_USD=30.0
SPREAD_MIN_DTE=5
SPREAD_MAX_DTE=14
SPREAD_PROFIT_TAKE_RATIO=0.50
SPREAD_STOP_LOSS_MULTIPLE=2.5
DISCLOSURE_FEED_PATH=data/disclosures.json
ALPACA_BARS_FEED=sip
ALPACA_QUOTE_FEED=iex
ENTRY_BLACKOUT_MINUTES_AFTER_OPEN=15
ENTRY_BLACKOUT_MINUTES_BEFORE_CLOSE=15
POLL_INTERVAL_SECONDS=60
DEFAULT_TRAILING_STOP_PCT=0.05
MIN_CONVICTION_SCORE=0.70
MAX_DISCLOSURE_LAG_DAYS=14
MIN_DAILY_DOLLAR_VOLUME=5000000.0
MAX_OPTION_SPREAD_PCT=0.25

# --- Persistence ---
SQLITE_DB_PATH=data/state.db
LOG_LEVEL=INFO
